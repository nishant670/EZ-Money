# FINNRI mobile app environment template.
# Copy to .env for local development. Keep real secrets out of Git.

# Where the app looks for the API. Inlined into the bundle at build time, so
# changing it means rebuilding, not just restarting Metro. Leave it unset and
# a dev build falls back to the machine serving Metro on the local network;
# a release build refuses to start rather than shipping that address.
# EAS builds take this from the matching profile's `env` block in eas.json.
EXPO_PUBLIC_API_URL=https://ez-money-be-production.up.railway.app

# Mobile OAuth client ID for Google sign-in. Google rejects Expo Go's
# `exp://...` redirect, so this only works from a development build.
# `EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID` and
# `EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID` are also accepted; the backend must list
# the same client ID in `GOOGLE_CLIENT_IDS` to verify the returned ID token.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-mobile-client-id
