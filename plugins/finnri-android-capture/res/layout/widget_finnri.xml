<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="16dp">

  <LinearLayout
    android:id="@+id/widget_summary"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <TextView
      android:id="@+id/widget_month"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/widget_month_default"
      android:textAllCaps="true"
      android:textColor="#94A3B8"
      android:textSize="11sp"
      android:textStyle="bold"/>
    <TextView
      android:id="@+id/widget_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:text="@string/widget_amount_default"
      android:textColor="#FFFFFF"
      android:textSize="20sp"
      android:textStyle="bold"/>
  </LinearLayout>

  <ImageButton
    android:id="@+id/widget_capture"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:background="@drawable/capture_circle"
    android:contentDescription="@string/capture_tile_label"
    android:padding="14dp"
    android:src="@drawable/ic_mic_widget"
    android:tint="#FFFFFF"/>
</LinearLayout>
