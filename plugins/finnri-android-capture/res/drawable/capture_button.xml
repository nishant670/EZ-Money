<?xml version="1.0" encoding="utf-8"?>
<!--
  The capture screen's primary action. A pill, because every primary CTA in the
  app is one — "Start tracking — it's free", "New group", "Add" — and this is
  the only button on the surface.

  `Radius.round` is 999 in `constants/theme.ts`; Android clamps a corner radius
  to half the view's height, so any value past that draws the same pill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <solid android:color="@color/finnri_accent"/>
  <corners android:radius="999dp"/>
</shape>
