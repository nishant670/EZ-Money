<?xml version="1.0" encoding="utf-8"?>
<!--
  The Finnri palette, for the two native surfaces that cannot read
  `constants/theme.ts` — the quick-capture activity and the home-screen widget.

  These are the Finnri mood's **dark** tokens, because both surfaces are always
  dark: the capture screen is a lock-screen surface, and a widget sits on a
  wallpaper it cannot measure. Values are copied from `constants/theme.ts` and
  have to be updated with it; there is no build step that checks them, so the
  names below are deliberately the same names the TypeScript uses.

  NOT named `colors.xml` on purpose. The plugin's `copyTree` overwrites by
  filename, and Expo generates its own `res/values/colors.xml` for the splash
  screen — landing on that name would silently replace it. Android merges every
  file in `values/`, so a distinct filename adds these without clobbering.
-->
<resources>
  <!-- palette.accent — the Finnri orange -->
  <color name="finnri_accent">#FF8865</color>
  <!-- onAccent, from createColors() -->
  <color name="finnri_on_accent">#FFFFFF</color>
  <!-- palette.backgroundDark -->
  <color name="finnri_background">#1A1A1A</color>
  <!-- ThemeMoods.finnri.dark.card -->
  <color name="finnri_card">#242424</color>
  <!-- palette.borderDark -->
  <color name="finnri_border">#3C3C3C</color>
  <!-- palette.textDark -->
  <color name="finnri_text">#FAFAFA</color>
  <!-- ThemeMoods.finnri.dark.neutral -->
  <color name="finnri_text_muted">#A3A3A3</color>
  <!--
    The app's muted convention is `${colors.text}99` — text at 60% alpha. Note
    the channel order differs: CSS writes #RRGGBBAA, Android writes #AARRGGBB,
    so the alpha moves to the front rather than the end.
  -->
  <color name="finnri_text_dim">#99FAFAFA</color>
</resources>
